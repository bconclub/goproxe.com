# Public Supabase config (used by app/lib/supabase.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vapi voice — public key, exposed to the client by @vapi-ai/web
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# Lead capture → Google Sheet.
# Server-only (NO NEXT_PUBLIC_ prefix) so the webhook URL never reaches the
# browser. Value = the Apps Script Web App /exec URL. Set this in the SERVER
# environment (e.g. .env.local on the host) — never commit the real value, the
# repo is public. Until set, /api/lead returns { ok:false, reason:'not_configured' }.
# See google-apps-script/README.md.
LEADS_WEBHOOK_URL=
