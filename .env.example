# Copy to .env.local and fill in. Never commit real values — the repo is public.

# ── Supabase (shared PROXe/Beacon instance) ──────────────────────────────────
# Public config, used by app/lib/supabase.ts on the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required by /api/lead and the Dodo webhook to write `all_leads`.
SUPABASE_SERVICE_ROLE_KEY=
# Tags rows this site creates so PROXe leads stay separable from Beacon's own
# inside the shared table. Defaults to 'proxe'.
PROXE_LEAD_BRAND=proxe

# ── Dodo Payments ────────────────────────────────────────────────────────────
# Server-only (NO NEXT_PUBLIC_ prefix) — these must never reach the browser.
# Dashboard → Developer → API Keys (needs read-write to create sessions).
DODO_PAYMENTS_API_KEY=
# Dashboard → Webhooks → endpoint → Secret Key. Verifies every delivery;
# without it /api/webhooks/dodo refuses to process anything.
DODO_PAYMENTS_WEBHOOK_KEY=
# test_mode | live_mode. Anything but live_mode is treated as test, so a
# missing or typo'd value can never charge a real card.
DODO_ENVIRONMENT=test_mode

# Product IDs (Dashboard → Products). Per-currency is preferred so checkout
# opens in the same currency the visitor saw on the pricing section.
DODO_PRODUCT_CORE_INR=
DODO_PRODUCT_CORE_USD=
# Per-seat add-on beyond the 2 bundled with Core. Leave blank if extra seats
# aren't self-serve yet — checkout still works for the base plan.
DODO_PRODUCT_SEAT_INR=
DODO_PRODUCT_SEAT_USD=
# Fallback for a single multi-currency product instead of the pairs above.
DODO_PRODUCT_CORE=
DODO_PRODUCT_SEAT=

# Absolute origin used to build checkout return/cancel URLs.
NEXT_PUBLIC_SITE_URL=https://goproxe.com

# ── ElevenLabs voice demo (replaces Vapi) ────────────────────────────────────
# Agent ID of a PUBLIC ElevenLabs agent — safe client-side, no API key in the
# browser. Restrict abuse via the agent's domain allowlist in the dashboard.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# ── Hero callback dialler (POST /api/callback) ───────────────────────────────
# Server-only. The SAME ElevenLabs key powers agent management and outbound
# dials; without it the hero capture still saves the lead, just doesn't ring.
ELEVENLABS_API_KEY=
# Optional overrides — sensible defaults are hardcoded in the route:
# the "PROXe Website Callback" agent + our SIP number (+91 80467 33388).
ELEVENLABS_CALLBACK_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=

# ── Lead capture → Google Sheet (backup sink alongside Supabase) ─────────────
# Server-only so the webhook URL never reaches the browser. Value = the Apps
# Script Web App /exec URL. Until set, /api/lead reports sheet:'not_configured'.
# See google-apps-script/README.md.
LEADS_WEBHOOK_URL=
